/release
*.exe
!Lib/osmw_chat_launch.exe
!Lib/osmw_login_launch.exe

# Native mod intermediates: .obj, .lib, .exp, .pdb and the generated _build.bat,
# all regenerated by one `python patches/<mod>/tools/build.py`. The shipped
# artifacts are Lib/osmw_*.dll and Lib/osmw_*_launch.exe, which ARE tracked.
/patches/*/build/
__pycache__/
*.pyc
*.zip
config.ini
layouts.ini
shop_presets.ini
better_hotkeys.ini
# Runtime output — written next to the exe, never read back except by LogTail.
mapsplusplus.log*
/releases
_addons.ahk
/docs/superpowers
/.superpowers
poi_pack.ini

.worktrees/
